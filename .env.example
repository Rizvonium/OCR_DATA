# --- Database (Supabase Postgres). Leave unset to use the built-in local database (.data/pglite).
# Supabase dashboard -> Connect -> "Transaction pooler" connection string (port 6543), with your DB password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Admin page (/admin) and exports. Required in production; any long random string.
ADMIN_KEY=

# --- Only for `npm run import -- DIR --storage supabase` (uploading pictures to Supabase Storage).
# Never put these in the browser or commit them.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# --- Optional tuning
# TASK_SECRET=            # signs served pictures; defaults to ADMIN_KEY
# IP_SALT=                # salt for hashed network addresses
# GOLD_SHARE=0.12         # share of check items after the first ten answers
# MAX_ANSWERS_PER_MINUTE=30
# DB_POOL_SIZE=3          # connections per server instance
# SEED_DEMO=0             # do not load the demo pictures into an empty database
# SIGNUPS_PER_NETWORK_PER_DAY=8
